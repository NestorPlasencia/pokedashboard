{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/prices.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/poke-db/:path*",
      "destination": "https://poke-db-git-master-nestorplasencias-projects.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
